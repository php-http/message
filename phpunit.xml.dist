<?xml version="1.0" encoding="UTF-8"?>
<!-- Kept free of version specific elements: this file must work with PHPUnit 8.5 up to the latest release. -->
<phpunit
    bootstrap="vendor/autoload.php"
    colors="true"
    beStrictAboutOutputDuringTests="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <php>
        <ini name="error_reporting" value="-1"/>
    </php>

    <testsuites>
        <testsuite name="php-http/message">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
